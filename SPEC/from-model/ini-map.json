{
  "artifact": "ini-map",
  "schemaVersion": 1,
  "derivation": "model",
  "derivedBy": "independent model pass (c): fresh-context read of git:parity-baseline:public/script.js (launchModelPresets preset-ini block) only. No fixture and no other derivation was consulted.",
  "sources": ["git:parity-baseline:public/script.js", "git:parity-baseline:server.js"],
  "builtBy": "launchModelPresets in the browser; the finished string is POSTed to /launch-presets and server.js writes it verbatim to <app dir>/models-preset.ini before spawning",
  "structure": {
    "header": "version = 1 followed by a blank line, before the first section",
    "sectionHeader": "[<config name>] - the localStorage key name verbatim, NOT a model file name (the file-name branch is commented out in the source)",
    "sectionOrder": "Object.entries(configs) insertion order from JSON.parse(localStorage.llamaCppConfigs) - insertion order is contractual; the rendered config LIST is separately sorted alphabetically, the ini is not",
    "sectionSeparator": "one blank line appended after every section, including the last",
    "trailing": "port = <settings.serverPort> is appended AFTER the whole loop and after the content has already been printed to the log pane, so the log pane shows everything except this line and the posted/recorded file bytes include it",
    "lineFormat": "<key> = <value> with single spaces around '=', each line terminated by \\n; nothing is quoted or escaped",
    "valueFormatting": "template-literal interpolation of the stored value, so numbers print as JS prints them (0.05 -> 0.05, 0 -> 0) and raw strings print verbatim (\"0.00\" -> 0.00)"
  },
  "rows": [
    { "order": 1, "key": "model", "value": "${config.modelPath}", "field": "modelPath", "guard": "if (config.modelPath)", "cliCounterpart": "-m", "nameDivergence": true },
    { "order": 2, "key": "mmproj", "value": "${model.mmprojFile}", "field": "modelPath", "guard": "window.models.forEach: model.path === config.modelPath && model.mmprojFile", "cliCounterpart": "--mmproj", "nameDivergence": true, "note": "first matching window.models entry wins (break)" },
    { "order": 3, "key": "temp", "value": "${config.temp}", "field": "temp", "guard": "if (config.temp !== undefined && config.temp >= 0)", "cliCounterpart": "--temp", "nameDivergence": false },
    { "order": 4, "key": "c", "value": "${config.contextSize.toString()}", "field": "contextSize", "guard": "if (config.contextSize > 0)", "cliCounterpart": "-c", "nameDivergence": false },
    { "order": 5, "key": "top-k", "value": "${config.topK}", "field": "topK", "guard": "if (config.topK !== undefined && config.topK > 0)", "cliCounterpart": "--top-k", "nameDivergence": false },
    { "order": 6, "key": "top-p", "value": "${config.topP}", "field": "topP", "guard": "if (config.topP !== undefined && config.topP >= 0)", "cliCounterpart": "--top-p", "nameDivergence": false },
    { "order": 7, "key": "min-p", "value": "${config.minP}", "field": "minP", "guard": "if ((!isNaN(parseFloat(config.minP)) && config.minP != \"0\") || config.minP == \"0.00\")", "cliCounterpart": "--min-p", "nameDivergence": false, "note": "identical loose zero predicate as argv (Q19)" },
    { "order": 8, "key": "repeat-penalty", "value": "${config.repeatPenalty}", "field": "repeatPenalty", "guard": "if ((!isNaN(parseFloat(config.repeatPenalty)) && config.repeatPenalty != \"0\") || config.repeatPenalty == \"0.00\")", "cliCounterpart": "--repeat-penalty", "nameDivergence": false },
    { "order": 9, "key": "presence-penalty", "value": "${config.presencePenalty}", "field": "presencePenalty", "guard": "if ((!isNaN(parseFloat(config.presencePenalty)) && config.presencePenalty != \"0\") || config.presencePenalty == \"0.00\")", "cliCounterpart": "--presence-penalty", "nameDivergence": false },
    { "order": 10, "key": "ngl", "value": "${config.ngl}", "field": "ngl", "guard": "if (config.ngl !== undefined && config.ngl > 0)", "cliCounterpart": "-ngl", "nameDivergence": false },
    { "order": 11, "key": "threads", "value": "${config.threads}", "field": "threads", "guard": "if (config.threads !== undefined && config.threads > 0)", "cliCounterpart": "-t", "nameDivergence": false },
    { "order": 12, "key": "n-cpu-moe", "value": "${config.nCpuMoe}", "field": "nCpuMoe", "guard": "if (config.nCpuMoe !== undefined && config.nCpuMoe > 0)", "cliCounterpart": "--n-cpu-moe", "nameDivergence": false },
    { "order": 13, "key": "cpu-moe", "value": "true (literal)", "field": "cpuMoe", "guard": "if (config.cpuMoe)", "cliCounterpart": "--cpu-moe (bare flag)", "nameDivergence": false, "note": "ini carries the literal 'true' where argv carries a bare flag" },
    { "order": 14, "key": "parallel", "value": "${config.parallel}", "field": "parallel", "guard": "if (config.parallel > 0)", "cliCounterpart": "--parallel", "nameDivergence": false },
    { "order": 15, "key": "load-mode", "value": "${config.loadMode}", "field": "loadMode", "guard": "if (config.loadMode !== undefined)", "cliCounterpart": "--load-mode", "nameDivergence": false, "note": "guard differs from argv truthiness: a blanked value emits 'load-mode = ' with an empty value (Q18)" },
    { "order": 16, "key": "no-kv-offload", "value": "true (literal)", "field": "noKvOffload", "guard": "if (config.noKvOffload !== undefined && config.noKvOffload)", "cliCounterpart": "--no-kv-offload (bare flag)", "nameDivergence": false },
    { "order": 17, "key": "no-mmproj-offload", "value": "true (literal)", "field": "noMmprojOffload", "guard": "if (config.noMmprojOffload !== undefined && config.noMmprojOffload)", "cliCounterpart": "--no-mmproj-offload (bare flag)", "nameDivergence": false },
    { "order": 18, "key": "cache-ram", "value": "${config.cacheRam}", "field": "cacheRam", "guard": "if (config.cacheRam !== undefined && !Number.isNaN(config.cacheRam))", "cliCounterpart": "--cache-ram", "nameDivergence": false },
    { "order": 19, "key": "jinja", "value": "true (literal)", "field": "jinja", "guard": "if (config.jinja !== undefined && config.jinja)", "cliCounterpart": "--jinja (bare flag)", "nameDivergence": false },
    { "order": 20, "key": "chat-template-kwargs", "value": "${config.chatTemplateKwargs}", "field": "chatTemplateKwargs", "guard": "if (config.chatTemplateKwargs)", "cliCounterpart": "--chat-template-kwargs", "nameDivergence": false },
    { "order": 21, "key": "chat-template-file", "value": "${config.modelPath.replace(/[/\\\\][^/\\\\]*$/, '')}\\\\chat-template.jinja", "field": "modelPath", "guard": "if (config.loadCustomChatTemplate !== undefined && config.loadCustomChatTemplate)", "cliCounterpart": "--chat-template-file", "nameDivergence": false, "note": "no modelPath guard, unlike argv - a config with the checkbox set and no modelPath throws here" },
    { "order": 22, "key": "verbose", "value": "true (literal)", "field": "verbose", "guard": "if (config.verbose !== undefined && config.verbose)", "cliCounterpart": "--verbose (bare flag)", "nameDivergence": false },
    { "order": 23, "key": "backend-sampling", "value": "true (literal)", "field": "backendSampling", "guard": "if (config.backendSampling !== undefined && config.backendSampling)", "cliCounterpart": "--backend-sampling (bare flag)", "nameDivergence": false },
    { "order": 24, "key": "fa", "value": "${config.fastAttention ?? 'auto'}", "field": "fastAttention", "guard": "if (config.fastAttention)", "cliCounterpart": "-fa [value]", "nameDivergence": true, "note": "ini always writes fa = <value>, including 'auto'; argv pushes the bare -fa for auto (Q9)" },
    { "order": 25, "key": "model-draft", "value": "${config.draftModelPath}", "field": "draftModelPath", "guard": "if (config.draftModelPath && config.speculationType !== 'none' && config.speculationType !== 'draft-mtp')", "cliCounterpart": "-md", "nameDivergence": true, "note": "name divergence, same guard as argv -md" },
    { "order": 26, "key": "ngld", "value": "${config.ngld}", "field": "ngld", "guard": "draft guard + if (config.ngld !== undefined && config.ngld >= 0)", "cliCounterpart": "-ngld", "nameDivergence": false, "note": "extra !== undefined conjunct compared with argv's bare >= 0" },
    { "order": 27, "key": "ctkd", "value": "${config.ctkd}", "field": "ctkd", "guard": "draft guard + if (config.ctkd)", "cliCounterpart": "-ctkd", "nameDivergence": false },
    { "order": 28, "key": "ctvd", "value": "${config.ctvd}", "field": "ctvd", "guard": "draft guard + if (config.ctvd)", "cliCounterpart": "-ctvd", "nameDivergence": false },
    { "order": 29, "key": "spec-type", "value": "${specTypes.join(',')}", "field": "speculationType", "guard": "outer: if (config.speculationType !== 'none' || config.ngramMod); inner: if (specTypes.length > 0)", "cliCounterpart": "--spec-type", "nameDivergence": false, "note": "same ngram-mod-first order as argv" },
    { "order": 30, "key": "spec-ngram-size-n", "value": "24 (literal)", "field": "ngramMod", "guard": "speculation guard + if (config.ngramMod)", "cliCounterpart": "--spec-ngram-mod-n-match", "nameDivergence": true, "note": "Q10 name divergence, Q15 hard-coded value" },
    { "order": 31, "key": "draft-min", "value": "48 (literal)", "field": "ngramMod", "guard": "speculation guard + if (config.ngramMod)", "cliCounterpart": "--spec-ngram-mod-n-min", "nameDivergence": true, "note": "Q10 name divergence, Q15 hard-coded value" },
    { "order": 32, "key": "draft-max", "value": "64 (literal)", "field": "ngramMod", "guard": "speculation guard + if (config.ngramMod)", "cliCounterpart": "--spec-ngram-mod-n-max", "nameDivergence": true, "note": "Q10 name divergence, Q15 hard-coded value" },
    { "order": 33, "key": "spec-draft-n-max", "value": "${config.specDraftNMax}", "field": "specDraftNMax", "guard": "speculation guard + if (config.specDraftNMax > 0 && config.speculationType !== 'none')", "cliCounterpart": "--spec-draft-n-max", "nameDivergence": false },
    { "order": 34, "key": "reasoning", "value": "${config.reasoning} OR ${config.disableReasoning ? 'off' : 'on'}", "field": "reasoning / disableReasoning", "guard": "if (config.reasoning !== undefined && config.reasoning !== 'auto') else if (config.disableReasoning !== undefined)", "cliCounterpart": "--reasoning off|on", "nameDivergence": false, "note": "Q17: the else-if reads the retired key, so the ini can contain 'reasoning' while argv has no --reasoning for the same config" },
    { "order": 35, "key": "port", "value": "${settings.serverPort}", "field": "serverPort", "guard": "none - appended unconditionally after the loop", "cliCounterpart": "--port", "nameDivergence": false, "note": "Q10 trailing key: it sits outside every section, after the final blank line" }
  ],
  "cliOnlyFlags": ["--swa-full", "-ctk", "-ctv"],
  "notEmittedToIni": ["swaFull (--swa-full has no ini key)", "contextTokenKey (-ctk has no ini key)", "contextTokenValue (-ctv has no ini key)", "ctkEnable", "serverPath", "configName except as the section name", "launchPresetsSelect"],
  "nameDivergences": [
    { "ini": "model", "cli": "-m" },
    { "ini": "mmproj", "cli": "--mmproj" },
    { "ini": "model-draft", "cli": "-md" },
    { "ini": "spec-ngram-size-n", "cli": "--spec-ngram-mod-n-match" },
    { "ini": "draft-min", "cli": "--spec-ngram-mod-n-min" },
    { "ini": "draft-max", "cli": "--spec-ngram-mod-n-max" },
    { "ini": "fa", "cli": "-fa" }
  ],
  "serverSideArgvFromPresetsEndpoint": {
    "note": "POST /launch-presets spawns its OWN argv, independent of the ini content",
    "args": ["--models-preset", "<app dir>/models-preset.ini", "--host", "0.0.0.0", "--port", "(body.serverPort || DEFAULT_PORT 8080).toString()"],
    "quirks": ["DEFAULT_PORT 8080 is used when the client omits serverPort, which is the second half of Q5", "the ini file is written before the serverPath guard runs, so a 400 'Server path not found' still leaves a rewritten models-preset.ini on disk"]
  }
}
