  "attributeNotes": {
    "order": "document order for index.html controls; 39-40 follow the markup string order inside openSettingsDialog; 41 is last because it has no control",
    "section": "text of the nearest preceding <h3> in index.html (configName's is the config dialog title); the two dialog controls are in the generated settings dialog",
    "defaultValue": "value attribute as written in the markup (string); for a <select> the value of the option carrying selected, else the first option's value",
    "options": "option VALUES in markup order; the labels are identical to the values everywhere except the three placeholder options",
    "optionsDynamic": "true when script.js rewrites the option list at runtime (modelPath/draftModelPath from /models, launchPresetsSelect from saved serverPaths)",
    "cliFlags": "flag literals this field feeds in the launchServer arg block, in source emission order",
    "iniKeys": "preset-ini key literals this field feeds in the launchModelPresets block, in source emission order; the global emission order lives in ini-map",
    "resetOnDelete": "true when deleteConfiguration assigns to the control (Q8 partial reset); resetValue is the hard-coded literal it assigns"
  },
