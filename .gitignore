# Parity port: real-state fixture corpus (contains personal absolute paths)
/migration-resources/
fixtures/corpus/.pathmap-local.json

.claude/
# fixture logs are recorded gate material, not runtime logs
!fixtures/**/*.log

# nightly/l1 cadence evidence (plan §7) is durable gate material, not a runtime log
!tools/parity/reports/nightly/*.log

# the negative controls' red-as-named traces: fixtures/NEGATIVES.md (pinned) cites each row's .log,
# so the child output behind every row has to survive a clone (AUDIT-2026-11-25 finding 13 class)
!tools/parity/reports/negatives/*.log

# mutation worker private input snapshot (regenerable from git)
tools/parity/reports/mutation/.snapshot/
# nightly/l2 scratch output
tests/*/out/
tools/parity/reports/watchdog-alert.json
tests/L2-ui/out/run-*.json
tests/L2-ui/out/screenshots/
.pi/subagents/schedules/
